# ─────────────────────────────────────────────────────────────
# Exemplo de configuração — Pix Antifraude API
#
# Você não precisa disto pra começar: o "docker compose up" sobe com
# todos os valores padrão. Copie para .env só se quiser trocar algo
# (uma porta ocupada, o token):
#   cp .env.example .env
#
# O .env nunca vai pro Git. Este arquivo só tem valor de mentirinha.
# ─────────────────────────────────────────────────────────────

# "local", "test" ou "production" — muda o nível do log.
APP_ENV=local

SERVICE_NAME=pix-antifraude-api

# Endereço do banco visto DE FORA do Docker (os testes usam esta linha).
# Dentro do compose a API usa "db:5432", fixo no docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://pix:pix@localhost:5432/pix_antifraude

# Header que protege as rotas da API:  INTERNAL-TOKEN: default_token
INTERNAL_TOKEN=default_token

# Onde os testes procuram a API e o mock, quando rodados fora do Docker.
SERVER_LOCALHOST=localhost

# ─────────────────────────────────────────────────────────────
# DICT (Banco Central) — quem faz o papel dele é o mock server
# ─────────────────────────────────────────────────────────────
# Dentro do compose a API usa http://mock:1080/dict, fixo no
# docker-compose.yml. Esta linha vale pra quem roda a API fora do Docker.
DICT_API_URL=http://localhost:1080/dict
DICT_API_INTERNAL_TOKEN=default_token

# Segundos de espera pelo DICT antes de desistir (aceita fração: 0.5).
DICT_API_TIMEOUT=1

# ─────────────────────────────────────────────────────────────
# Portas — troque se alguma já estiver ocupada na sua máquina
# ─────────────────────────────────────────────────────────────
#API_PORT=3001
#DB_PORT=5433
#MOCK_PORT=1081
